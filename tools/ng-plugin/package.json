    "./package.json": "./package.json",
    "./generators.json": "./generators.json"
  },
  "peerDependencies": {
    "@nx/angular": "^24.0.0",
    "@nx/devkit": "^24.0.0",
    "typescript": "^5.4.0 || ^6.0.0"
  }
