{
  "name": "@rn-forge/ng-plugin",
  "version": "0.4.0",
  "description": "Nx generators that set up Angular apps and libraries for the rn-forge Angular packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rn-forge/ngkit",
    "directory": "tools/ng-plugin"
  },
  "publishConfig": {
