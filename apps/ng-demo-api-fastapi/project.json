{
  "name": "ng-demo-api-fastapi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ng-demo-api-fastapi",
  "tags": ["scope:ngkit", "type:app"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "uv run --project apps/ng-demo-api-fastapi python apps/ng-demo-api-fastapi/serve.py localhost:8100"
      }
    }
  }
}
