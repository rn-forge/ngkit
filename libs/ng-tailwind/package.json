{
  "name": "@rn-forge/ng-tailwind",
  "version": "0.5.0",
  "description": "Token-driven, Tailwind-compatible presentation components for the rn-forge toolkit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rn-forge/ngkit",
    "directory": "libs/ng-tailwind"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./tokens.css": "./assets/tokens.css",
    "./base.css": "./assets/base.css",
    "./tailwind.css": "./assets/tailwind.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@angular/core": "^22.0.6",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
