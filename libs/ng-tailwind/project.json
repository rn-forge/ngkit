{
  "name": "ng-tailwind",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ng-tailwind/src",
  "prefix": "rnf",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "{projectRoot}",
        {
          "path": "dist/{projectRoot}",
          "preserveLocalDependencyProtocols": false
        }
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:ngkit", "type:ui", "publishable"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/ng-tailwind/ng-package.json",
        "tsConfig": "libs/ng-tailwind/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ng-tailwind/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "pack": {},
    "verify-dist": {},
    "verify-consumer": {},
    "consumer-fixture": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/consumer/ng-tailwind-app.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/dist/consumer-fixtures/rn-forge-ng-tailwind-*/tailwind-22.1-zoneless"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "task ci:consumer -- libs/ng-tailwind --cell tailwind-22.1-zoneless"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "dryRun": true
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "compodoc": {
      "executor": "@twittwer/compodoc:compodoc",
      "outputs": ["{workspaceRoot}/dist/compodoc/ng-tailwind"],
      "options": {
        "tsConfig": "libs/ng-tailwind/tsconfig.compodoc.json",
        "outputPath": "dist/compodoc/ng-tailwind"
      },
      "configurations": {
        "json": {
          "exportFormat": "json"
        },
        "serve": {
          "serve": true,
          "watch": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "configDir": "libs/ng-tailwind/.storybook",
        "tsConfig": "libs/ng-tailwind/.storybook/tsconfig.json",
        "styles": ["libs/ng-tailwind/assets/tokens.css"],
        "port": 4401
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "configDir": "libs/ng-tailwind/.storybook",
        "tsConfig": "libs/ng-tailwind/.storybook/tsconfig.json",
        "styles": ["libs/ng-tailwind/assets/tokens.css"],
        "outputDir": "dist/storybook/ng-tailwind"
      },
      "configurations": {
        "production": {}
      }
    }
  }
}
